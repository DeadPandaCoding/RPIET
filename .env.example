# Supabase connection (optional).
# Without these the app runs in local browser-storage demo mode with no auth.
# With them, the app requires sign-in (Supabase Auth) and stores each owner's
# data in Postgres behind per-user Row Level Security. See supabase/schema.sql.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
